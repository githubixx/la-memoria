{
  "name": "bookmarker",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "format": "gofmt -w $(find bookmarker adapters cmd tests -name '*.go' -type f 2>/dev/null)",
    "test:unit": "go test ./bookmarker/...",
    "test:contract": "go test -tags=contract ./tests/contract/...",
    "test:integration": "go test -tags=integration ./tests/integration/...",
    "test:compose-integration": "go test -tags=integration ./tests/integration/ -run TestCompose",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  }
}