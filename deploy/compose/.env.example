# Optional local deployment overrides. Keep credentials in .env.credentials.
BOOKMARKER_HOST_PORT=8080
BOOKMARKER_POSTGRES_VOLUME=bookmarker-postgres-data
BOOKMARKER_SCREENSHOTS_VOLUME=bookmarker-screenshots
BOOKMARKER_CONFIG_VOLUME=bookmarker-config
# One-time migration only: set in a temporary Compose override with a
# read-only export mount, then remove both after successful initialization.
# BOOKMARKER_CONFIG_IMPORT_PATH=/import/config.yaml