# Required local credentials. Replace every placeholder in deploy/compose/.env.
BOOKMARKER_ADMIN_USERNAME=replace-with-admin-username
BOOKMARKER_ADMIN_PASSWORD_HASH=replace-with-argon2id-verifier
BOOKMARKER_DB_PASSWORD=replace-with-database-password

# Optional local deployment overrides.
BOOKMARKER_HOST_PORT=8080
BOOKMARKER_POSTGRES_VOLUME=bookmarker-postgres-data
BOOKMARKER_SCREENSHOTS_VOLUME=bookmarker-screenshots